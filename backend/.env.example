# Copy this file to .env and adjust values for your local environment.
# Never commit a real .env file with secrets.

APP_NAME=Momentum Stock Scanner
APP_ENV=development
LOG_LEVEL=INFO

# PostgreSQL connection string
# Format: postgresql+psycopg2://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/momentum_stock_scanner

# JSON list of allowed frontend origins for CORS
CORS_ORIGINS=["http://localhost:5173"]

# --- Daily NIFTY 500 hybrid signal scanner ---

# Telegram alerts. Create a bot via @BotFather on Telegram, send it any
# message, then GET https://api.telegram.org/bot<token>/getUpdates to
# read back your chat_id. See README.md "Telegram setup" for full steps.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALERTS_ENABLED=false
TELEGRAM_MAX_NOTIFICATIONS_PER_SCAN=20

# Daily scheduler. Disabled by default - set to true to run automatically
# on weekdays at SCAN_HOUR_IST:SCAN_MINUTE_IST (NSE closes 15:30 IST;
# SCAN_POST_CLOSE_DELAY_MINUTES is informational here, baked into the
# default hour/minute below already).
SCHEDULER_ENABLED=false
SCHEDULER_TIMEZONE=Asia/Kolkata
SCAN_POST_CLOSE_DELAY_MINUTES=45
SCAN_HOUR_IST=16
SCAN_MINUTE_IST=15

# Required to use POST /api/v1/scans/run, /api/v1/telegram/test, or
# /api/v1/universe/refresh - leave blank to keep those endpoints disabled.
# Send it back as the X-Scan-Api-Key header.
SCAN_API_KEY=

# Per-symbol fetch concurrency/retry during a scan.
SCAN_MAX_CONCURRENT_SYMBOLS=5
SCAN_MAX_RETRIES=3
SCAN_RETRY_BACKOFF_SECONDS=2.0
